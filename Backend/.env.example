# ── ScreenSiri Backend Environment Variables ─────────────────────────────────
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# Required: OpenAI API Key
OPENAI_API_KEY=sk-...

# Optional: Gemini API Key (for advanced dual-AI pipeline)
# GEMINI_API_KEY=AIza...

# Optional: API secret key for request authentication
# Uncomment to require X-API-Key header from the iOS app
# API_SECRET_KEY=your-random-secret-here
